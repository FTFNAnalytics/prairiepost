# The Prairie Dispatch — Apache rewrite and protection rules.
Options -Indexes

<IfModule mod_rewrite.c>
RewriteEngine On

# Application internals are never served directly: code, runtime data,
# server-side tools and tests, vendored dependencies, and runbooks. The
# cron/ scripts stay reachable BY DESIGN — each one 403s without the
# site's cron secret (web-cron support for hosts without a crontab).
RewriteRule ^(app|data|tools|tests|vendor|docs)(/|$) - [F,L]
# Dotfiles and dot-directories (.git, .htaccess, …), except the ACME
# challenge path certbot needs.
RewriteRule ^\.well-known/acme-challenge/ - [L]
RewriteRule (^|/)\. - [F,L]
# Database dumps, shell scripts, backups and markdown never leave the box.
RewriteRule \.(sqlite[0-9]*|sql|sh|md|bak|dist|lock)$ - [F,L]
# Nothing in uploads/ ever executes.
RewriteRule ^uploads/.+\.(php|phtml|phar)$ - [F,L]

# Pretty URLs.
RewriteRule ^story/([a-z0-9-]+)/?$ article.php?slug=$1 [L,QSA]
RewriteRule ^desk/([a-z0-9-]+)/?$ section.php?slug=$1 [L,QSA]
RewriteRule ^region/([a-z0-9-]+)/?$ region.php?slug=$1 [L,QSA]
RewriteRule ^author/([a-z0-9-]+)/?$ author.php?slug=$1 [L,QSA]
RewriteRule ^search/?$ search.php [L,QSA]
RewriteRule ^feed/?$ feed.php [L]
RewriteRule ^sitemap\.xml$ sitemap.php [L]
RewriteRule ^subscribe/?$ subscribe.php [L,QSA]
RewriteRule ^contact/?$ contact.php [L,QSA]
# The monitoring ingest API. Apache drops the Authorization header for
# FastCGI unless it's re-exported — the E= flag carries the bearer through.
RewriteRule ^api/monitor/?$ monitor-ingest.php [L,QSA,E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
# Pantheon media gateway. The script itself returns 404 outside the Civis hub.
RewriteRule ^api/media/?$ media-gateway.php [L,QSA,E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
RewriteRule ^ad/?$ ad.php [L,QSA]
RewriteRule ^card/([a-z0-9-]+)\.png$ card.php?slug=$1 [L]
RewriteRule ^corrections/?$ corrections.php [L]
RewriteRule ^about/?$ about.php [L]
RewriteRule ^newsletter(/.*)?$ newsletter.php?path=$1 [L,QSA]
</IfModule>

<FilesMatch "^(config\.php|config\.example\.php|composer\.json|composer\.lock|router\.php)$">
  Require all denied
</FilesMatch>

# Sensible caching for static assets.
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType text/css "access plus 7 days"
ExpiresByType image/svg+xml "access plus 30 days"
ExpiresByType image/png "access plus 30 days"
ExpiresByType image/jpeg "access plus 30 days"
ExpiresByType application/javascript "access plus 7 days"
</IfModule>
